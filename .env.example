# ===== 梦之韵模组发布系统 配置模板 =====
# 复制为 .env 并填写

PORT=3000
BASE_URL=http://localhost:3000

# GitHub OAuth（注册：Settings → Developer settings → OAuth Apps）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub 发布 Token（必填，需要 repo 权限）
GITHUB_TOKEN=

# 发布仓库与管理员 GitHub 用户名
REPO_OWNER=maoxinhe
REPO_NAME=modpack
ADMIN_LOGIN=maoxinhe

MODS_DIR=./mods
DATA_DIR=./data
DIST_DIR=./dist

# 生产环境请使用强随机值
SESSION_SECRET=please-change-me

# 可选：开发用管理 Token，生产环境留空
DEV_AUTH_TOKEN=

MAX_UPLOAD_MB=100
